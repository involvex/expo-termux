{
  "name": "@involvex/expo-termux",
  "version": "0.1.0",
  "description": "Expo module for Termux integration",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "android",
    "plugin/build"
  ],
  "scripts": {
    "build": "node internal/module_scripts/prepare.js",
    "build:plugin": "tsc --build plugin",
    "clean": "node internal/module_scripts/clean.js && node internal/module_scripts/clean.js plugin",
    "prepublishOnly": "bun run build",
    "lint": "eslint src/ plugin/src/",
    "lint:fix": "eslint src/ plugin/src/ --fix",
    "test": "bun x jest",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "typecheck:plugin": "tsc --noEmit -p plugin/tsconfig.json",
    "prebuild": "bun run format && bun run lint:fix && bun run typecheck"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-termux",
    "ExpoTermux"
  ],
  "repository": "https://github.com/involvex/expo-termux",
  "bugs": {
    "url": "https://github.com/involvex/expo-termux/issues"
  },
  "author": "involvex <39644169+involvex@users.noreply.github.com> (https://github.com/involvex)",
  "license": "MIT",
  "homepage": "https://github.com/involvex/expo-termux#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@expo/config-plugins": "~57.0.9",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.21",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "react-native": "0.86.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
